        };

        // WM practice layer entry on H, mirroring the G entry. Positional: only the LEFT-hand WM keys can trigger the hold. Higher idle guard than G because H is followed by a trigger key in "have"/"he"/"has", which G is not.
        WM_hold_H_v1: WM_hold_H_v1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            bindings = <&mo>, <&kp>;
