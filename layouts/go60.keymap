            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
        };

        // WM practice layer entry on G. Positional: only the WM keys can trigger the hold, so ordinary words containing g resolve as a tap.
        WM_hold_v1: WM_hold_v1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            bindings = <&mo>, <&kp>;
