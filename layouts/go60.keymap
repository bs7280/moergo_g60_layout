            bindings = <&kp F3>;
            layers = <LAYER_HRM_macOS LAYER_HRM_WinLinx LAYER_Typing LAYER_Autoshift>;
        };

        // F5 combo for Go60 - TailorKey
        combo_F5_cb_v1_TKZ {
            key-positions = <POS_LH_C1R2 POS_LH_C1R1>;
            bindings = <&kp F5>;
            layers = <LAYER_HRM_macOS LAYER_HRM_WinLinx LAYER_Typing LAYER_Autoshift>;
        };

        // F6 combo for Go60 - TailorKey
        combo_F6_cb_v1_TKZ {
            key-positions = <POS_RH_C1R1 POS_RH_C1R2>;
            bindings = <&kp F6>;
            layers = <LAYER_HRM_macOS LAYER_HRM_WinLinx LAYER_Typing LAYER_Autoshift>;
        };

        // F7 combo for Go60 - TailorKey
        combo_F7_cb_v1_TKZ {
            key-positions = <POS_RH_C2R1 POS_RH_C2R2>;
            bindings = <&kp F7>;
            layers = <LAYER_HRM_macOS LAYER_HRM_WinLinx LAYER_Typing LAYER_Autoshift>;
        };

        // F8 combo for Go60 - TailorKey
        combo_F8_cb_v1_TKZ {
            key-positions = <POS_RH_C3R1 POS_RH_C3R2>;
            bindings = <&kp F8>;
            layers = <LAYER_HRM_macOS LAYER_HRM_WinLinx LAYER_Typing LAYER_Autoshift>;
        };

        // F9 combo for Go60 - TailorKey
        combo_F9_cb_v1_TKZ {
            key-positions = <POS_RH_C4R1 POS_RH_C4R2>;
            bindings = <&kp F9>;
            layers = <LAYER_HRM_macOS LAYER_HRM_WinLinx LAYER_Typing LAYER_Autoshift>;
        };

        // sticky "hyper" modifiers (Win + Alt + Ctrl + Shift) - Use with Tab - TailorKey
        combo_sticky_hyp_rght_v1_TKZ {
            timeout-ms = <50>;
            key-positions = <POS_RH_C2R5 POS_RH_C2R4>;
            bindings = <&sk LG(LA(LC(LSHFT)))>;
            layers = <LAYER_HRM_macOS LAYER_Autoshift LAYER_HRM_WinLinx>;
        };

        // sticky "meh" modifiers (Alt + Ctrl + Shift) - Use with Tab - TailorKey
        combo_sticky_meh_rght_v1_TKZ {
            timeout-ms = <50>;
            key-positions = <POS_RH_C3R5 POS_RH_C3R4>;
            bindings = <&sk LA(LC(LSHFT))>;
            layers = <LAYER_HRM_macOS LAYER_Autoshift LAYER_HRM_WinLinx>;
        };

        // Alt Tab Switcher (Cursor Layer) - TailorKey
        combo_tabswitch_alt_v1_TKZ {
            key-positions = <POS_LH_C4R4 POS_LH_C4R5>;
            bindings = <&mod_tab_chord_v2_TKZ LALT LAYER_Cursor>;
            layers = <LAYER_HRM_macOS LAYER_Typing LAYER_Autoshift LAYER_HRM_WinLinx>;
        };

        // Alt Tab Switcher (Cursor Layer) - TailorKey
        combo_tabswitch_ctrl_v1_TKZ {
            key-positions = <POS_LH_C2R4 POS_LH_C2R5>;
            bindings = <&mod_tab_chord_v2_TKZ LCTRL LAYER_Cursor>;
            layers = <LAYER_HRM_macOS LAYER_Typing LAYER_Autoshift LAYER_HRM_WinLinx>;
        };

        // Alt Tab Switcher (Cursor Layer) - TailorKey
        combo_tabswitch_gui_v1_TKZ {
            key-positions = <POS_LH_T1 POS_LH_C1R4>;
            bindings = <&mod_tab_chord_v2_TKZ LGUI LAYER_Cursor>;
            layers = <LAYER_HRM_macOS LAYER_Typing LAYER_Autoshift LAYER_HRM_WinLinx>;
        };

        // toggle gaming layer - TailorKey
        combo_gaming_layer_v1_TKZ {
            timeout-ms = <50>;
            key-positions = <POS_LH_C1R4 POS_LH_C2R5>;
            bindings = <&tog LAYER_Gaming>;
        };
    };
};

/* Automatically generated keymap */
/ {
    keymap {
        compatible = "zmk,keymap";


        layer_HRM_macOS {
            bindings = <
            &kp EQUAL                          &kp N1                        &kp N2                         &kp N3                          &kp N4                           &kp N5                                                                                                                                                                                                                          &kp N6                           &kp N7                          &kp N8                         &kp N9                              &kp N0         &kp MINUS
              &kp TAB                           &kp Q                         &kp W                          &kp E                           &kp R                            &kp T                                                                                                                                                                                                                           &kp Y                            &kp U                           &kp I                          &kp O                               &kp P          &kp BSLH
              &kp ESC  &HRM_left_pinky_v1_TKZ LCTRL A  &HRM_left_ring_v1_TKZ LALT S  &HRM_left_middy_v1_TKZ LGUI D  &HRM_left_index_v1_TKZ LSHFT F  &WM_hold_v1 LAYER_WM_practice G                                                                                                                                                                                               &WM_hold_H_v1 LAYER_WM_practice H  &HRM_right_index_v1_TKZ RSHFT J  &HRM_right_middy_v1_TKZ RGUI K  &HRM_right_ring_v1_TKZ LALT L  &HRM_right_pinky_v1_TKZ RCTRL SEMI           &kp SQT
 &magic LAYER_Magic 0                           &kp Z                         &kp X                          &kp C                           &kp V                            &kp B                                                                                                                                                                                                                           &kp N                            &kp M                       &kp COMMA                        &kp DOT                            &kp FSLH  &td_LAYER_Keypad
                                                                           &kp HOME                       &kp LEFT                       &kp RIGHT                                                                                                                                                                                                                                                                                            &kp UP                        &kp DOWN                        &kp END
                                                                                                                                                                                     &thumb_v2_TKZ LAYER_Cursor_macOS BSPC  &thumb_v2_TKZ LAYER_Keypad DEL  &kp LSHFT  &thumb_v2_TKZ LAYER_VSCode_macOS LG(ESC)  &thumb_v2_TKZ LAYER_Mouse RET  &space_v3_TKZ LAYER_Symbol SPACE
            >;
        };

        layer_HRM_WinLinx {
            bindings = <
            &kp EQUAL                         &kp N1                        &kp N2                          &kp N3                          &kp N4                      &kp N5                                                                                                                                                                                                             &kp N6                           &kp N7                           &kp N8                         &kp N9                             &kp N0         &kp MINUS
              &kp TAB                          &kp Q                         &kp W                           &kp E                           &kp R                       &kp T                                                                                                                                                                                                              &kp Y                            &kp U                            &kp I                          &kp O                              &kp P          &kp BSLH
              &kp ESC  &HRM_left_pinky_v1_TKZ LGUI A  &HRM_left_ring_v1_TKZ LALT S  &HRM_left_middy_v1_TKZ LCTRL D  &HRM_left_index_v1_TKZ LSHFT F  &WM_hold_v1 LAYER_WM_Win G                                                                                                                                                                                       &WM_hold_H_v1 LAYER_WM_Win H  &HRM_right_index_v1_TKZ RSHFT J  &HRM_right_middy_v1_TKZ RCTRL K  &HRM_right_ring_v1_TKZ LALT L  &HRM_right_pinky_v1_TKZ RGUI SEMI           &kp SQT
 &magic LAYER_Magic 0                          &kp Z                         &kp X                           &kp C                           &kp V                       &kp B                                                                                                                                                                                                              &kp N                            &kp M                        &kp COMMA                        &kp DOT                           &kp FSLH  &td_LAYER_Keypad
                                                                          &kp HOME                        &kp LEFT                       &kp RIGHT                                                                                                                                                                                                                                                                          &kp UP                         &kp DOWN  &thumb_v2_TKZ LAYER_Teams END
                                                                                                                                                                                &thumb_v2_TKZ LAYER_Cursor BSPC  &thumb_v2_TKZ LAYER_Keypad DEL  &kp LSHFT  &thumb_v2_TKZ LAYER_VSCode_Win LS(F17)  &thumb_v2_TKZ LAYER_Mouse RET  &space_v3_TKZ LAYER_Symbol SPACE
            >;
        };

        layer_Typing {
            bindings = <
               &trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans    &trans  &trans
               &trans  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans    &trans  &trans
               &trans   &kp A   &kp S   &kp D   &kp F   &kp G                                                   &kp H   &kp J   &kp K   &kp L  &kp SEMI  &trans
 &magic LAYER_Magic 0  &trans  &trans  &trans  &trans  &trans                                                  &trans  &trans  &trans  &trans    &trans  &trans
                               &trans  &trans  &trans                                                                  &trans  &trans  &trans
                                                               &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_Autoshift {
            bindings = <
